# Optional Geo basemap. The map works without either of these — only the background
# tiles are affected. Copy this file to .env.local and restart `npm run dev`
# (or rebuild: these values are baked into the JavaScript at build time).
#
# VITE_CARTO_API_KEY=your_carto_basemap_key
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; Your tile provider
